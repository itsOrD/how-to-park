{
  "name": "how-to-park",
  "version": "1.0.0",
  "description": "crowd sourced interactive parking maps",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "nodemon server",
    "build": "webpack --progress --color --mode development --watch",
    "build:once": "webpack --mode development",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsOrD/how-to-park.git"
  },
  "keywords": [
    "park"
  ],
  "author": "itsOrD",
  "license": "CC0-1.0",
  "bugs": {
    "url": "https://github.com/itsOrD/how-to-park/issues"
  },
  "homepage": "https://github.com/itsOrD/how-to-park#readme",
  "dependencies": {
    "axios": "^1.13.4",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "grommet": "^2.47.0",
    "grommet-icons": "^4.13.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.28.5",
    "@playwright/test": "^1.58.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.0",
    "babel-jest": "^30.2.0",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^13.0.1",
    "express": "^4.21.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "mongoose": "^8.15.1",
    "nodemon": "^3.1.10",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  }
}
