# How To Park — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Port the Express server listens on (default: 1111)
PORT=1111

# MongoDB connection string (default: local instance)
MONGODB_URI=mongodb://localhost/howtopark

# Comma-separated list of allowed CORS origins (default: http://localhost:<PORT>)
# ALLOWED_ORIGINS=http://localhost:1111,https://yourdomain.com
